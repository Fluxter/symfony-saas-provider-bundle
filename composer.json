{
    "name": "fluxter/saas-provider-bundle",
    "description": "The SaaS Provider Bundle for easy SaaS provisioning",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcel",
            "email": "kontakt@fluxter.net"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/doctrine-bundle": "^2.12 || ^3.0",
        "doctrine/orm": "^2.17 || ^3.0",
        "doctrine/persistence": "^3.1 || ^4.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/doctrine-bridge": "^7.0 || ^8.0",
        "symfony/event-dispatcher": "^7.0 || ^8.0",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/http-foundation": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/options-resolver": "^7.0 || ^8.0",
        "symfony/routing": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/service-contracts": "^3.0",
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Fluxter\\SaasProviderBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fluxter\\SaasProviderBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
